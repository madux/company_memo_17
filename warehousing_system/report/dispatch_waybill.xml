<odoo>
  <data> 
    <record id="print_dispatch_waybill_report" model="ir.actions.report">
        <field name="name">WayBill - Dispatch</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">warehousing_system.dispatch_waybill_print_report_template</field>
        <field name="report_file">warehousing_system.dispatch_waybill_print_report_template</field>
        <field name="print_report_name">'Dispatch WayBill for - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="attachment_use">True</field>
	</record>
    <template id="dispatch_waybill_print_report_template">
      <t t-call="web.html_container">
          <t t-foreach="docs" t-as="o">
              <t t-call="warehousing_system.dispatch_waybill_print_template"/>
          </t>
      </t>
    </template>
    <template id="dispatch_waybill_print_template">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
            <div class="page" style="padding-top: 10px;">
                <style>
                 table {
                    border-collapse: collapse;
                    margin-bottom: 40px;
                }

                 

                .thead-style {
                    background-color:rgb(69, 68, 68);
                    color: #fff;
                }

                table, th, tr, td, h3 {
                    font-size: 14px
                }
                .title-header {
                    font-size: 30px 
                }

                table, th, tr, td {
                    border:1px solid #f4f0f0;
                    font-family: sans-serif;
                    margin-bottom: 3px;
                    font-size: 11px;
                }

                th, td{
                    padding: 5px;
                }

                td:nth-child(4) {
                    color: black;
                }
                .accounthead {
                    background-color: #ccc;
                }


                .outstanding {
                    color: red;
                }

                .flex-color {
                    background-color:rgb(249, 6, 6);
                    text-align: left;
                    color: #ffffff
                }
                </style>
                <div class="row flex-color p-3">
                    <div class="col-2">
                    <!-- border:1px solid #f4f0f0; -->
                        <span class="report-header"> <t t-esc="o.financial_id.code"/> <p> <span class="report-header"> <t t-esc="o.customer_id.name"/></span></p> </span> 
                    </div>
                    <div class="col-2 text-center">
                    </div>
                    <div class="col-2 offset-5 text-end">
                        <strong><span class="report-header"> <t t-esc="o.name"/> </span></strong>
                    </div>
                </div>
                 
                 <div class='row'>
                    <div class="col-2">
                         <span class="report-header">Order Size: <t t-esc="len([r.id for r in o.move_ids_without_package])"/> item(s)</span>
                    </div>
                    <div class="col-2 offset-2 text-center">
                    </div>
                    <div class="col-2 offset-3 text-end">
                        <span class="report-header"><t t-esc="o.write_uid.name"/><p><span class="report-header"> <t t-esc="datetime.datetime.now().strftime('%B %d, %Y')"/></span></p> </span> 
                    </div>
                </div>
                 
                <div class="d-flex bd-highlight">
                    <div class="p-2 flex-grow-1 bd-highlight">
                        <h3 class="text-bold flex-color p-2">ORDER DETAILS</h3>
                        <div class="table-responsive mt-0">
                            <table style="width:100%">
                                <thead>
                                    <tr>
                                        <th class="thead-style" width="40%">
                                        </th>
                                        <th class="thead-style" width="60%">
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Our Order Number: </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.name"/></h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Customer </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.customer_id.name"/></h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold"> Destination of Goods: </h3>
                                        </td>
                                        <td>
                                            <h5 class="text-bold"><t t-esc="o.customer_address"/></h5>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold"> Notes </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold pb-3"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="p-2 bd-highlight">
                        <h3 class="text-bold flex-color p-2">TRUCK DRIVER DETAILS</h3>
                        <div class="table-responsive mt-0">
                            <table style="width:100%">
                                <thead>
                                    <tr>
                                        <th class="thead-style" width="40%">
                                        </th>
                                        <th class="thead-style" width="60%">
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Truck Company Name </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.truck_company_name.name"/></h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Truck Registration No </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.truck_reg"/></h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Truck Type </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold pb-3"><t t-esc="o.truck_type"/></h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Driver Name </h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.truck_driver.name"/></h3>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>   
                <div class='alert alert-danger' role="alert">
                    <h3 class="text-bold flex-color p-2">RELATED INVENTORY ITEMS DETAILS</h3>
                </div>
 

                <div class="table-responsive">
                    <table style="width:100%">
                        <thead>
                            <tr>
                                <th class="thead-style" width="10%">
                                    # Our item ID
                                </th>
                                
                                <th class="thead-style" width="20%">
                                    Description
                                </th>
                                <th class="thead-style" width="10%">
                                    Inner Qty
                                </th>
                                <th class="thead-style" width="10%">
                                    UOM
                                </th>
                                <th class="thead-style" width="10%">
                                    PO No.
                                </th>
                                <th class="thead-style" width="15%">
                                    File No.
                                </th>
                                <th class="thead-style" width="15%">
                                    Date in
                                </th>
                                <th class="thead-style" width="20%">
                                    Vessel Name
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.move_ids_without_package">
                                <t t-foreach="o.move_ids_without_package" t-as="wbi">
                                    <tr>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.name"/>/<t t-esc="wbi.id"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.product_id.name"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.quantity"/></h3>
                                        </td>
                                        
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.product_uom.name"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.supplier_po_number"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.financial_id.code"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.waybill_date.strftime('%B %d, %Y')"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.customer_id.name"/></h3>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="o.dispatch_picking_ids_packages">
                                <t t-foreach="o.dispatch_picking_ids_packages" t-as="wbi">
                                    <tr>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.name"/>/<t t-esc="wbi.id"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.product_id.name"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.quantity"/></h3>
                                        </td>
                                        
                                        <td>
                                            <h3 class="text-bold"><t t-esc="wbi.product_uom.name"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.supplier_po_number"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.financial_id.code"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.waybill_date.strftime('%B %d, %Y')"/></h3>
                                        </td>
                                        <td>
                                            <h3 class="text-bold"><t t-esc="o.customer_id.name"/></h3>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>  
                <div class="d-flex bd-highlight">
                    <div class="p-2 flex-grow-1 bd-highlight">
                        <h3 class="text-bold flex-color p-2">Signature Box</h3>
                        <div class="table-responsive">
                            <table class="table align-items-left mb-0">
                                <thead>
                                    <tr>
                                        <th class="thead-style" width="50%">
                                        </th>
                                        <th class="thead-style" width="50%">
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Client Name:</h3>
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Date/Time</h3>
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <h3 class="text-bold">Signature</h3>
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
      </t>

    </template>

 
  </data>
</odoo>
