<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_inventory_tree" model="ir.ui.view">
        <field name="name">memo.warehouse.inventory.tree</field>
        <field name="model">memo.model</field>
        <field name="inherit_id" eval="False"/> <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <tree string="Warehouse Inventory">
                <!-- <field name="memo_type" invisible="1"/> -->
                <field name="name"/>
                <field name="financial_id"/>
                <field name="warehouse_id"/>
                <field name="inventory_status"/>
                <field name="actual_date_of_arrival"/>
                <field name="expected_arrival_date"/>
                <field name="receiving_supplier_id"/>
                <field name="customer_id"/>
                <field name="intended_vessel"/>
            </tree>
        </field>
    </record>

    <record id="view_warehouse_inventory_form" model="ir.ui.view">
        <field name="name">memo.warehouse.inventory.form</field>
        <field name="model">memo.model</field>
        <field name="inherit_id" eval="False"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Warehouse Inventory">
                 <div class="oe_chatter">
                     <field name="message_follower_ids"/>
                     <field name="activity_ids"/>
                     <field name="message_ids"/>
                 </div>
                <sheet>
                    <header>
                         <!-- <field name="inventory_status" widget="statusbar" statusbar_visible="draft,arrived,allocated,done"/> -->
                         <field name="stage_id" widget="statusbar" readonly="0" options="{'clickable': '1'}"/>
                         <button name="action_pre_allocate" type="object" string="Pre-Allocate" class="oe_highlight" invisible="inventory_status != 'arrived'"/>
                         </header>
                    <h1>
                        <field name="name" placeholder="e.g. Receipt for PO SO123"/>
                    </h1>
                    <group>
                        <group>
                            <field name="memo_type" invisible="1"/>
                            <field name="memo_setting_id" invisible="1"/>
                            <field name="financial_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="warehouse_id" options="{'no_create': True}"/>
                            <field name="inbound_picking_id"
                                    options="{'no_create': True}"
                                    domain="[('picking_type_id.code','=','incoming')]"
                                    context="{'default_picking_type_code':'incoming'}"/>
                            <field name="supplier_po_number"/>
                            <field name="inventory_status" />
                        </group>
                        <group>
                           <field name="expected_arrival_date"/>
                           <field name="actual_date_of_arrival"/>
                        </group>
                    </group>
                    <group>
                        <group>
                             <field name="receiving_supplier_id" options="{'no_create': True}"/>
                             <field name="supplier_po_number"/>
                        </group>
                         <group>
                            <field name="receiving_waybill_number"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="critical_equipment"/>
                        </group>
                        <group>
                            <field name="intended_vessel"/>
                        </group>
                    </group>
                    
                    <!-- ====== ITEMS (PO LINES) ====== -->
                    <group string="Item Details (per item)" colspan="4">
                        <field name="po_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="name"         string="Description"/>
                            <field name="product_qty"  string="Qty"/>
                            <field name="product_uom"  string="UoM"/>
                            <field name="price_unit"   string="Unit Price"/>
                        </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_warehouse_inventory" model="ir.actions.act_window">
        <field name="name">Warehouse Inventory</field>
        <field name="res_model">memo.model</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="[( 'memo_type', '=', ref('warehousing_system.mtype_warehouse') )]"/>
        <field name="context" eval="{
            'default_memo_type': ref('warehousing_system.mtype_warehouse'),
            'default_memo_setting_id': ref('warehousing_system.memo_config_warehouse'),
        }"/>
        <!-- <field name="views" eval="[
          ( ref('view_warehouse_inventory_tree'), 'tree' ),
          ( ref('view_warehouse_inventory_form'), 'form' )
      ]"/> -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_warehouse_inventory_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_warehouse_inventory_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Warehouse Inventory Memo.
            </p><p>
                This section tracks items arriving at the warehouse before allocation or shipment.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_warehouse_system_root"
        name="Warehouse Operations"
        sequence="50"/>

    <menuitem
        id="menu_warehouse_inventory"
        name="Warehouse Inventory Receipts"
        parent="menu_warehouse_system_root"
        action="action_warehouse_inventory"
        sequence="10"/>

</odoo>