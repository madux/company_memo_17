      <record id="action_warehouse_inventory" model="ir.actions.act_window">
        <field name="name">Warehouse Inventory Receipts</field>
        <field name="res_model">stock.picking</field>
        <!-- we open the form first, then tree -->
        <field name="view_mode">form,tree</field>
        <!-- default_form (the first one) -->
        <field name="view_id" ref="warehousing_system.view_warehouse_inventory_tree"/>
        <!-- full list of views -->
        <field name="views" eval="[
            (ref('warehousing_system.view_warehouse_inventory_form'), 'form'),
            (ref('warehousing_system.view_warehouse_inventory_tree'), 'tree')
          ]"/>
        <!-- only incoming receipts -->
        <field name="domain">[('picking_type_code','=','incoming')]</field>
        <!-- set defaults on create if you like -->
        <field name="context">{'default_picking_type_code': 'incoming'}</field>
      </record>
      

    <menuitem
        id="menu_warehouse_system_root"
        name="Warehouse Operations"
        sequence="50"/>

    <menuitem
        id="menu_warehouse_inventory"
        name="Warehouse Inventory Receipts"
        parent="warehousing_system.menu_warehouse_system_root"
        action="warehousing_system.action_warehouse_inventory"
        sequence="1"/>

