<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_inventory_tree" model="ir.ui.view">
        <field name="name">stock.picking.warehouse.tree</field>
        <field name="model">stock.picking</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
          <tree string="Warehouse Inventory Receipts">
            <field name="name"/>
            <field name="financial_id" context="{'show_address': False}"/>
            <field name="warehouse_id"/>
            <field name="inventory_status"/>
            <field name="actual_date_of_arrival"/>
            <field name="expected_arrival_date"/>
            <field name="receiving_supplier_id"/>
          </tree>
        </field>
    </record>

    <record id="view_warehouse_inventory_form" model="ir.ui.view">
        <field name="name">stock.picking.warehouse.form.custom</field>
        <field name="model">stock.picking</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Inventory Creation">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" class="oe_inline" placeholder="Inventory Creation"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="warehouse_id" placeholder="Select Warehouse *" options="{'no_create': True}"/>
                            <field name="financial_id" placeholder="Select Warehouse File" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="inventory_status" placeholder="Select Inventory Status *" 
                                   widget="selection" options="{'no_create': True}"/>
                            <field name="inbound_picking_id" placeholder="Related Inbound Shipment" 
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" placeholder="Company *" options="{'no_create': True}"/>
                            <field name="actual_date_of_arrival" placeholder="Actual Arrival Date"/>
                        </group>
                    </group>
                    
                    <!-- Item Info block -->
                    <div class="o_horizontal_separator mt-4 mb-3">Item Info</div>
                    <group>
                        <group>
                            <field name="customer_id" required="1" placeholder="Customer *" options="{'no_create': True}"/>
                            <field name="intended_vessel" placeholder="Intended Vessel" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="critical_equipment" placeholder="Critical Equipment" options="{'no_create': True}"/>
                            <field name="unit_of_measure_id" placeholder="Unit of Measure" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="amount" placeholder="Amount" widget="integer"/>
                        </group>
                    </group>
         
                    <!-- Item Details -->
                    <div class="o_horizontal_separator mt-4 mb-3">Item Details (per item)</div>
                    <field name="item_line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="description" placeholder="Item Description *"/>
                            <field name="customer_reference" placeholder="Customer Reference"/>
                            <field name="qty"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

