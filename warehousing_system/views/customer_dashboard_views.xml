<odoo>
    <data>
        <!-- Main page template -->
        <template id="public_warehouse_dashboard_template" name="Public Warehouse Dashboard Page">
            <t t-call="website.layout">
                <!-- Call frontend assets to load OWL and component -->
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                
                <div class="container-fluid mt-4">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="text-center mb-4">Warehouse Inventory Dashboard</h1>
                        </div>
                    </div>
                    <div id="public-warehouse-dashboard" class="mb-5">
                        <!-- Loading indicator while component initializes -->
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Initializing dashboard...</span>
                            </div>
                            <p class="mt-2">Loading dashboard...</p>
                        </div>
                    </div>
                </div>
                
                <!-- Call frontend assets JS at the end -->
                <t t-call-assets="web.assets_frontend"/>
            </t>
        </template>
    </data>
</odoo>