<odoo>
    <data>
        <!-- Kanban-style Dashboard View -->
        <record id="view_warehouse_inventory_dashboard" model="ir.ui.view">
            <field name="name">warehouse.inventory.dashboard</field>
            <field name="model">stock.picking</field>
            <field name="type">kanban</field>  <!-- Critical fix -->
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <kanban class="o_dashboard">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <!-- First Row of Actions -->
                                <div class="row mb-4">
                                    <div class="col-3">
                                        <a type="action" 
                                           name="stock.action_picking_type_list" 
                                           class="btn btn-primary"
                                           string="Inventory Creation Form"/>
                                    </div>
                                    <div class="col-3">
                                        <a type="action" 
                                           name="stock.action_picking_tree_all" 
                                           domain="[('state','=','assigned'),('picking_type_code','=','incoming')]"
                                           class="btn btn-light"
                                           string="Put Away to Section"/>
                                    </div>
                                </div>

                                <!-- Second Row of Actions -->
                                <div class="row">
                                    <div class="col-3">
                                        <a type="action" 
                                           name="stock.action_picking_tree_all"
                                           domain="[('picking_type_code','=','incoming')]"
                                           class="btn btn-light"
                                           string="Inbound Shipments"/>
                                    </div>
                                    <div class="col-3">
                                        <a type="action" 
                                           name="stock.action_picking_tree_all"
                                           domain="[('picking_type_code','=','outgoing')]"
                                           class="btn btn-light"
                                           string="Outbound Orders"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Corrected Action -->
        <record id="action_warehouse_inventory_dashboard" model="ir.actions.act_window">
            <field name="name">Warehouse Dashboard</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">kanban,tree,form</field>  <!-- Changed to kanban -->
            <field name="view_id" ref="view_warehouse_inventory_dashboard"/>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_warehouse_inventory_dashboard"
                  name="Warehouse Dashboard"
                  parent="warehousing_system.menu_warehouse_system_root"
                  action="action_warehouse_inventory_dashboard"
                  sequence="10"/>
    </data>
</odoo>