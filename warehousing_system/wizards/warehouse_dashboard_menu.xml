<odoo>
    <!-- Launch wizard, then generate tiles -->
    <record id="action_open_warehouse_dashboard_wizard" model="ir.actions.act_window">
      <field name="name">Warehouse Dashboard</field>
      <field name="res_model">warehouse.dashboard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="view_id" ref="view_warehouse_dashboard_wizard_form"/>
    </record>
  
    <!-- After setting filters, user clicks "Generate" button -->
    <record id="warehouse_dashboard_generate" model="ir.ui.view">
      <field name="name">warehouse.dashboard.wizard.form</field>
      <field name="model">warehouse.dashboard</field>
      <field name="arch" type="xml">
        <form string="Warehouse Dashboard">
          <group>
            <field name="client_id"/>
            <field name="file_type"/>
            <field name="project_no"/>
            <field name="month"/>
            <field name="year"/>
          </group>
          <footer>
            <button string="Generate Dashboard"
                    type="object"
                    name="action_create_tiles"
                    class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>
  
    <menuitem id="menu_warehouse_dashboard"
              name="Dashboard"
              parent="warehousing_system.menu_warehouse_system_root"
              action="action_open_warehouse_dashboard_wizard"
              sequence="2"/>
  </odoo>
  