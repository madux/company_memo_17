<odoo>
    <record id="view_warehouse_dashboard_kanban" model="ir.ui.view">
      <field name="name">warehouse.dashboard.kanban</field>
      <field name="model">warehouse.dashboard</field>
      <field name="arch" type="xml">
        <kanban create="false" default_group_by="">
          <field name="kanban_dashboard"/>
          <templates>
            <t t-name="kanban-box">
              <!-- parse the JSON computed in Python -->
              <t t-set="data" t-value="JSON.parse(record.kanban_dashboard.raw_value || '{}')"/>
  
              <!-- static maps for titles & icons -->
              <t t-set="titles" t-value="{
                'waiting_for_info':  'Inventory Items Waiting for Info',
                'expected_tomorrow': 'Inventory Items Expected Tomorrow',
                'expected_today':    'Inventory Items Expected Today',
                'items_to_put':      'Items to be Put in Stock',
                'without_storage':   'Inventory Items without Storage',
                'labels_to_print':   'Labels to be Printed',
                'items_90days':      'Items > 90 days in Stock',
                'open_osd':          'Open OS&amp;D Inventory',
                'displaced_items':   'Displaced Inventory Items'
              }"/>
              <t t-set="icons" t-value="{
                'waiting_for_info':  'fa-info-circle',
                'expected_tomorrow': 'fa-hourglass-half',
                'expected_today':    'fa-clock-o',
                'items_to_put':      'fa-shopping-cart',
                'without_storage':   'fa-ban',
                'labels_to_print':   'fa-print',
                'items_90days':      'fa-calendar',
                'open_osd':          'fa-lock',
                'displaced_items':   'fa-truck'
              }"/>
  
              <div class="o_warehouse_dashboard_grid">
                <t t-foreach="Object.entries(data)" t-as="pair">
                  <t t-set="key"   t-value="pair[0]"/>
                  <t t-set="count" t-value="pair[1] || 0"/>
                  <div class="oe_kanban_card dashboard_item"
                       t-att-data-action="'action_view_' + key">
                    <div class="item_icon">
                      <i t-attf-class="fa #{icons[key]} text-danger"/>
                    </div>
                    <div class="item_count">
                      <t t-esc="count"/>
                    </div>
                    <div class="item_title">
                      <t t-esc="titles[key]"/>
                    </div>
                  </div>
                </t>
              </div>
  
            </t>
          </templates>
        </kanban>
      </field>
    </record>
  
    <!-- <record id="action_warehouse_inventory_dashboard" model="ir.actions.act_window">
      <field name="name">Warehouse Inventory Dashboard</field>
      <field name="res_model">warehouse.dashboard</field>
      <field name="view_mode">kanban</field>
      <field name="context">{}</field>
      <field name="view_id" ref="view_warehouse_dashboard_kanban"/>
    </record>
  
    <menuitem id="menu_warehouse_inventory_dashboard"
              name="Dashboard"
              action="action_warehouse_inventory_dashboard"
              parent="warehousing_system.menu_warehouse_system_root"
              sequence="1"/> -->
  </odoo>
  