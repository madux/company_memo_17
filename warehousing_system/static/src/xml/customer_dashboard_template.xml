<odoo>
    <data>
        <!-- Main page template -->
        <template id="public_warehouse_dashboard_template" name="Public Warehouse Dashboard Page">
            <t t-call="website.layout">
                <!-- <t t-set="head">
                <t t-call-assets="warehousing_system.assets_warehouse_dashboard"/>
                </t> -->
                <head>
                    <link
                    rel="stylesheet"
                    href="/warehousing_system/static/src/css/customer_dashboard.css"
                    />
                </head>
                <div class="container-fluid mt-4">
                    <h1 class="text-center mb-4">Warehouse Inventory Dashboard</h1>

                    <!-- Dashboard Content -->
                    <div id="public-warehouse-dashboard">
                        <!-- Filters -->
                        <div class="dashboard-filters mb-4">
                            <div class="row">
                                <div class="col-md-4">
                                    <label>Client</label>
                                    <input type="text" class="form-control" id="client-filter"
                                           placeholder="Search by client name"/>
                                </div>
                                <div class="col-md-4">
                                    <label>Month</label>
                                    <select class="form-control" id="month-filter">
                                        <option value="All">All</option>
                                        <option value="Jan">Jan</option>
                                        <option value="Feb">Feb</option>
                                        <option value="Mar">Mar</option>
                                        <option value="Apr">Apr</option>
                                        <option value="May">May</option>
                                        <option value="Jun">Jun</option>
                                        <option value="Jul">Jul</option>
                                        <option value="Aug">Aug</option>
                                        <option value="Sep">Sep</option>
                                        <option value="Oct">Oct</option>
                                        <option value="Nov">Nov</option>
                                        <option value="Dec">Dec</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label>Year</label>
                                    <select class="form-control" id="year-filter">
                                        <option value="All">All</option>
                                        <option value="2025">2025</option>
                                        <option value="2024">2024</option>
                                        <option value="2023">2023</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Dashboard Cards -->
                        <div id="dashboard-cards" class="dashboard-cards">
                            <!-- Initial loading state -->
                            <div id="loading-state" class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <p class="mt-2">Loading dashboard data...</p>
                            </div>

                            <!-- Error state (hidden by default) -->
                            <div id="error-state" class="alert alert-danger" role="alert" style="display: none;">
                                <i class="fa fa-exclamation-triangle mr-2"></i>
                                <span id="error-message">An error occurred while loading the dashboard.</span>
                            </div>

                            <!-- Dashboard cards container (hidden by default) -->
                            <div id="cards-container" class="row" style="display: none;">
                                <t t-foreach="[('waitingForInfo','fa-info-circle','Inventory Items Waiting for Info'),
                                                ('expectedTomorrow','fa-hourglass-half','Inventory Items Expected Tomorrow'),
                                                ('expectedToday','fa-clock-o','Inventory Items Expected Today'),
                                                ('toBePutInStock','fa-cart-plus','Items to be Put in Stock'),
                                                ('withoutAllocatedStorage','fa-ban','Items without Allocated Storage'),
                                                ('labelsToBePrinted','fa-print','Labels to be Printed'),
                                                ('longerThan90Days','fa-clock','Items >90 Days in Stock'),
                                                ('openOSDInventory','fa-unlock-alt','Open OS&amp;D Inventory'),
                                                ('displacedItems','fa-truck-moving','Items Displaced'),
                                                ('dispatchedItems','fa-truck','Items Dispatched')]" t-as="item">
                                    <t t-set="category" t-value="item[0]"/>
                                    <t t-set="icon" t-value="item[1]"/>
                                    <t t-set="title" t-value="item[2]"/>
                                    <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                                        <div
                                            class="warehouse-card red-card"
                                            t-att-data-category="category"
                                            t-att-data-title="title">
                                            <div class="card-icon">
                                                <i t-att-class="'fa ' + icon"/>
                                            </div>
                                            <div class="card-count" t-att-id="'count-' + category">0</div>
                                            <div class="card-title" t-esc="title"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detail Modal -->
                <div class="modal fade" id="detailModal" tabindex="-1" role="dialog"
                     aria-labelledby="detailModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="detailModalLabel">Details</h5>
                                <button type="button" class="close" data-dismiss="modal"
                                        aria-label="Close"><span aria-hidden="true">×</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <!-- Loading state -->
                                <div id="modal-loading" class="text-center py-4" style="display: none;">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                    <p class="mt-2">Loading details...</p>
                                </div>

                                <!-- Empty state -->
                                <div id="modal-empty" class="alert alert-info" role="alert" style="display: none;">
                                    <i class="fa fa-info-circle mr-2"></i> No items found for this category.
                                </div>

                                <!-- Detail table -->
                                <div id="modal-table" class="table-responsive" style="display: none;">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Reference</th>
                                                <th>Client</th>
                                                <th>Status</th>
                                                <th>Scheduled Date</th>
                                            </tr>
                                        </thead>
                                        <tbody id="detail-table-body">
                                            <!-- Dynamic content will be inserted here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                            <script
                            type="module"
                            src="/warehousing_system/static/src/js/customer_dashboard.js"
                            ></script>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>