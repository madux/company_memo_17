<odoo>
    <data>
        <template id="public_warehouse_dashboard_template" name="Public Warehouse Dashboard Page">
            <t t-call="warehousing_system.warehouse_layout">
                <!-- Include only our dashboard assets -->
                <!-- <t t-set="head">
                    <t t-call-assets="warehousing_system.assets_warehouse_dashboard"/>
                </t> -->
                <head>
                    <link
                    rel="stylesheet"
                    href="/warehousing_system/static/src/css/customer_dashboard.css"
                    />
                </head>

                <div class="warehouse-dashboard container-fluid px-4">
                    <!-- Header Section with Branding -->
                    <!-- <div class="dashboard-header mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
