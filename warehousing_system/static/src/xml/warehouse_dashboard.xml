<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="warehousing_system.WarehouseDashboard" owl="1">
    <div class="warehouse-dashboard container-fluid px-4">
      <h1 class="mb-4">Warehouse Inventory Dashboard</h1>

      <!-- Updated filter controls with text inputs for client and projectNo -->
      <div class="dashboard-filters mb-4">
        <div class="row">
          <div class="col">
            <label>Client</label>
            <input type="text" class="form-control" t-att-value="state.filters.client" 
                   placeholder="Search by client name" 
                   t-on-input="(ev) => this.onClientInputChange(ev, 'client')" />
          </div>
          <div class="col">
            <label>File Type</label>
            <select class="form-control" t-on-change="(ev) => this.onFilterChange(ev, 'fileType')">
              <t t-foreach="state.statusOptions" t-as="option" t-key="option.id">
                <option t-att-value="option.id" t-att-selected="state.filters.fileType === option.id">
                  <t t-esc="option.name"/>
                </option>
              </t>
            </select>
          </div>
          <div class="col">
            <label>Project No.</label>
            <input type="text" class="form-control" t-att-value="state.filters.projectNo" 
                   placeholder="Search by project number" 
                   t-on-input="(ev) => this.onClientInputChange(ev, 'projectNo')" />
          </div>
          <div class="col">
            <label>Month</label>
            <select class="form-control" t-on-change="(ev) => this.onFilterChange(ev, 'month')">
              <option value="All" t-att-selected="state.filters.month === 'All'">All</option>
              <option value="Jan" t-att-selected="state.filters.month === 'Jan'">Jan</option>
              <option value="Feb" t-att-selected="state.filters.month === 'Feb'">Feb</option>
              <option value="Mar" t-att-selected="state.filters.month === 'Mar'">Mar</option>
              <option value="Apr" t-att-selected="state.filters.month === 'Apr'">Apr</option>
              <option value="May" t-att-selected="state.filters.month === 'May'">May</option>
              <option value="Jun" t-att-selected="state.filters.month === 'Jun'">Jun</option>
              <option value="Jul" t-att-selected="state.filters.month === 'Jul'">Jul</option>
              <option value="Aug" t-att-selected="state.filters.month === 'Aug'">Aug</option>
              <option value="Sep" t-att-selected="state.filters.month === 'Sep'">Sep</option>
              <option value="Oct" t-att-selected="state.filters.month === 'Oct'">Oct</option>
              <option value="Nov" t-att-selected="state.filters.month === 'Nov'">Nov</option>
              <option value="Dec" t-att-selected="state.filters.month === 'Dec'">Dec</option>
            </select>
          </div>
          <div class="col">
            <label>Year</label>
            <select class="form-control" t-on-change="(ev) => this.onFilterChange(ev, 'year')">
              <option value="All" t-att-selected="state.filters.year === 'All'">All</option>
              <option value="2025" t-att-selected="state.filters.year === '2025'">2025</option>
              <option value="2024" t-att-selected="state.filters.year === '2024'">2024</option>
              <option value="2023" t-att-selected="state.filters.year === '2023'">2023</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Dashboard cards (unchanged) -->
      <div class="dashboard-cards">
        <!-- Card 1 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_waiting_for_info', [['inventory_status', '=', 'draft']], 'Inventory Items Waiting for Info')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-info-circle"/></div>
            <div class="card-count"><t t-esc="state.stats.waitingForInfo"/></div>
            <div class="card-title">Inventory Items Waiting for Info</div>
          </div>
        </div>
        <!-- Rest of the cards remain unchanged -->
        <!-- Card 2 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_expected_tomorrow', [['expected_arrival_date', '=', 'tomorrow']], 'Inventory Items Expected Tomorrow')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-hourglass-half"/></div>
            <div class="card-count"><t t-esc="state.stats.expectedTomorrow"/></div>
            <div class="card-title">Inventory Items Expected Tomorrow</div>
          </div>
        </div>
        <!-- Card 3 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_expected_today', [['expected_arrival_date', '=', 'today']], 'Inventory Items Expected Today')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-clock-o"/></div>
            <div class="card-count"><t t-esc="state.stats.expectedToday"/></div>
            <div class="card-title">Inventory Items Expected Today</div>
          </div>
        </div>
        <!-- Card 4 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_to_put_in_stock', [['inventory_status', '=', 'arrived']], 'Items to be Put in Stock')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-cart-plus"/></div>
            <div class="card-count"><t t-esc="state.stats.toBePutInStock"/></div>
            <div class="card-title">Items to be Put in Stock</div>
          </div>
        </div>
        <!-- Card 5 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_without_allocated_storage', [['warehouse_id', '=', false], ['inventory_status', 'not in', ['draft','cancelled']]], 'Inventory Items without Allocated Storage')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-ban"/></div>
            <div class="card-count"><t t-esc="state.stats.withoutAllocatedStorage"/></div>
            <div class="card-title">Inventory Items without Allocated Storage</div>
          </div>
        </div>
        <!-- Card 6 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_labels_to_print', [], 'Labels to be Printed')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-print"/></div>
            <div class="card-count"><t t-esc="state.stats.labelsToBePrinted"/></div>
            <div class="card-title">Labels to be Printed</div>
          </div>
        </div>
        <!-- Card 7 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_long_term_stock', [], 'Inventory Items >90 Days in Stock')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-clock-rotate-left"/></div>
            <div class="card-count"><t t-esc="state.stats.longerThan90Days"/></div>
            <div class="card-title">Inventory Items >90 Days in Stock</div>
          </div>
        </div>
        <!-- Card 8 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_open_osd_inventory', [['inventory_status', '=', 'waiting']], 'Open OS&amp;D Inventory in Stock')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-unlock-alt"/></div>
            <div class="card-count"><t t-esc="state.stats.openOSDInventory"/></div>
            <div class="card-title">Open OS&amp;D Inventory in Stock</div>
          </div>
        </div>
        <!-- Card 9 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_displaced_items', [['warehouse_id', '!=', false], ['inventory_status', '=', 'allocated']], 'Inventory Items Displaced')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-truck-moving"/></div>
            <div class="card-count"><t t-esc="state.stats.displachedItems"/></div>
            <div class="card-title">Inventory Items Displaced</div>
          </div>
        </div>
        <!-- Card 10 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_expected_today_alt', [['expected_arrival_date','=', 'today']], 'Inventory Items Expected Today (Alt)')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-hard-hat"/></div>
            <div class="card-count"><t t-esc="state.stats.expectedToday"/></div>
            <div class="card-title">Inventory Items Expected Today</div>
          </div>
        </div>
        <!-- Card 11 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_expected_tomorrow_alt', [['expected_arrival_date','=', 'tomorrow']], 'Inventory Items Expected Tomorrow (Alt)')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-hard-hat"/></div>
            <div class="card-count"><t t-esc="state.stats.expectedTomorrow"/></div>
            <div class="card-title">Inventory Items Expected Tomorrow</div>
          </div>
        </div>
        <!-- Card 12 -->
        <div class="col-card" t-on-click="() => this.onCardClick('action_view_dispatched', [], 'Inventory Items Dispatched')">
          <div class="warehouse-card red-card">
            <div class="card-icon"><i class="fa fa-truck"/></div>
            <div class="card-count"><t t-esc="state.stats.dispatchedItems || 0"/></div>
            <div class="card-title">Inventory Items Dispatched</div>
          </div>
        </div>
      </div>
    </div>
  </t>
</templates>